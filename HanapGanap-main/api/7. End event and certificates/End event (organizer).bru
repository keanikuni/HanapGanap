meta {
  name: End event (organizer)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/events/{{eventId}}/end
  body: none
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

tests {
  test("Status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Event is completed", function () {
    expect(res.body.event.status).to.equal("completed");
  });
  test("Summary shows the attendance", function () {
    expect(res.body.summary.attended).to.be.greaterThan(0);
  });
}
