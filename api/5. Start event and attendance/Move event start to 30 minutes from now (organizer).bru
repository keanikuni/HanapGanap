meta {
  name: Move event start to 30 minutes from now (organizer)
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/events/{{eventId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "startDatetime": "{{soonStart}}",
    "endDatetime": "{{laterEnd}}",
    "registrationDeadline": "{{earlierDeadline}}"
  }
}

script:pre-request {
  // Test-only shortcut: puts the start inside the 2-hour early-start window
  bru.setVar("soonStart", new Date(Date.now() + 30 * 60 * 1000).toISOString());
  bru.setVar("laterEnd", new Date(Date.now() + 3 * 3600 * 1000).toISOString());
  bru.setVar("earlierDeadline", new Date(Date.now() - 3600 * 1000).toISOString());
}

tests {
  test("Status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
