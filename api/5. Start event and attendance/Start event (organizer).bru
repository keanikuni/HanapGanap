meta {
  name: Start event (organizer)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/events/{{eventId}}/start
  body: none
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

tests {
  test("Status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Event is ongoing", function () {
    expect(res.body.event.status).to.equal("ongoing");
  });
}
