meta {
  name: Notify registrants (organizer)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events/{{eventId}}/notify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "title": "Venue changed",
    "message": "The summit is now at Room 204, Engineering Building.",
    "type": "schedule_change"
  }
}

tests {
  test("Status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
