meta {
  name: Wrong password (expect 401)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{studentEmail}}",
    "password": "wrong"
  }
}

tests {
  test("Status is 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
