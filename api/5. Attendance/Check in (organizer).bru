meta {
  name: Check in (organizer)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/attendance/check-in
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "registrationId": {{registrationId}}
  }
}

tests {
  test("Status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
