meta {
  name: Manual check-in again (expect 409)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/attendance/check-in
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "registrationId": {{registrationId}}
  }
}

tests {
  test("Status is 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
