meta {
  name: Scan unknown QR (expect 404)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/attendance/scan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "eventId": {{eventId}},
    "qrToken": "not-a-real-token"
  }
}

tests {
  test("Status is 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
