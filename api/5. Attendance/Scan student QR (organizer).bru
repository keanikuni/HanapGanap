meta {
  name: Scan student QR (organizer)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/attendance/scan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "eventId": {{eventId}},
    "qrToken": "{{qrToken}}"
  }
}

tests {
  test("Status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
