meta {
  name: Download certificate too early (expect 409)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/events/{{eventId}}/certificate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

tests {
  test("Status is 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
