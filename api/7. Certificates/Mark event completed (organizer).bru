meta {
  name: Mark event completed (organizer)
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/events/{{eventId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "status": "completed"
  }
}

tests {
  test("Status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
