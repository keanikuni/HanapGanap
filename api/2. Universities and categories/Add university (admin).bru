meta {
  name: Add university (admin)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/universities
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Test University {{runId}}",
    "emailDomain": "test.edu.ph",
    "address": "Angeles City, Pampanga"
  }
}

script:post-response {
  if (res.body && res.body.id) bru.setVar("newUniversityId", res.body.id);
}

tests {
  test("Status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
