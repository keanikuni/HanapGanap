meta {
  name: Make sure main university is active (admin)
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/universities/{{universityId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "isActive": true
  }
}

tests {
  test("Status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
