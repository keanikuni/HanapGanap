meta {
  name: Create event (organizer)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "categoryId": {{categoryId}},
    "title": "Tech Summit 2026",
    "description": "A day of talks and workshops.",
    "venue": "Main Auditorium",
    "startDatetime": "2026-12-10T09:00:00+08:00",
    "endDatetime": "2026-12-10T17:00:00+08:00",
    "registrationDeadline": "2026-12-08T23:59:00+08:00",
    "participantLimit": 200
  }
}

script:post-response {
  if (res.body && res.body.id) bru.setVar("eventId", res.body.id);
}

tests {
  test("Status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
