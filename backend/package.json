{
  "name": "hanapganap-backend",
  "version": "1.0.0",
  "description": "REST API for HanapGanap, a web-based management and cataloging system for university-wide events",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "seed": "node --env-file=.env prisma/seed.js",
    "seed:mock": "node --env-file=.env prisma/seed-mock.js",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^7.0.0"
  }
}